# After installing integrations/visionfit into your local Laravel backend.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
DATA_MODE=live
# Basic deterministic replies with REAL API data; no paid model required to test.
AI_MODE=demo
DB_PATH=./data/assistant.sqlite
VISIONFIT_API_URL=http://127.0.0.1:8000/api
VISIONFIT_MEMBER_LOGIN_PATH=/client/login
VISIONFIT_TRAINER_LOGIN_PATH=/trainer/login
VISIONFIT_ADMIN_LOGIN_PATH=/admin/login
VISIONFIT_ME_PATH=/assistant/me
VISIONFIT_CONTEXT_PATH=/assistant/context
# Only configure these when enabling a real language model.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=
ALLOW_CUSTOMER_DATA_TO_AI=false
