# Node.js >=24. Default works immediately with synthetic data, no AI key.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
DATA_MODE=demo
AI_MODE=demo
DB_PATH=./data/assistant.sqlite
SESSION_TTL_MINUTES=60
HISTORY_RETENTION_DAYS=30
CHAT_LIMIT_PER_HOUR=30
LOGIN_LIMIT_PER_15_MINUTES=15
# Set live only after implementing and verifying docs/VISIONFIT_API.md.
VISIONFIT_API_URL=http://127.0.0.1:8000/api
VISIONFIT_MEMBER_LOGIN_PATH=/client/login
VISIONFIT_TRAINER_LOGIN_PATH=/trainer/login
VISIONFIT_ADMIN_LOGIN_PATH=/admin/login
VISIONFIT_ME_PATH=/assistant/me
VISIONFIT_CONTEXT_PATH=/assistant/context
# For AI_MODE=live: key stays on server; model must be available to your account.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=
# Required for DATA_MODE=live + AI_MODE=live: approve sending minimized data to provider.
ALLOW_CUSTOMER_DATA_TO_AI=false
