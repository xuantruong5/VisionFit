{
  "name": "visionfit-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone Vietnamese fitness assistant for VisionFit",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env apps/api/index.js",
    "start": "node --env-file-if-exists=.env apps/api/index.js",
    "test": "node --test tests/api/*.test.js tests/contracts/*.test.js tests/web/*.test.js",
    "check": "node scripts/check.js",
    "setup:visionfit": "node scripts/install-visionfit.js",
    "test:api": "node --test tests/api/*.test.js",
    "test:contracts": "node --test tests/contracts/*.test.js",
    "test:web": "node --test tests/web/*.test.js"
  }
}
